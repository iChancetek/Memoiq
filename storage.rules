rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any files in the user's private folder.
    // The path segments are wildcarded to match any file.
    match /{userId}/{allPaths=**} {
      // Allow read and write access only if the user is authenticated
      // and their UID matches the {userId} in the path.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
