rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write their own files in their own folder
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.metadata.uid;
    }

    // Rules for the scribe audio files.
    // This allows a user to read and write to their own directory.
    match /scribe-audio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
