rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own data, stored in a document named after their UID.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Memos are stored in a top-level collection.
    // A user can create a memo if they are logged in.
    // They can only read, update, or delete their own memos.
    match /memos/{memoId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Tasks are stored in a top-level collection.
    // A user can create a task if they are logged in.
    // They can only read, update, or delete their own tasks.
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }
  }
}
